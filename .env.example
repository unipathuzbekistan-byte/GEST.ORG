# The startup script creates a local .env with secure random secrets on first run.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/gest.sqlite
SESSION_SECRET=
VERIFICATION_HMAC_SECRET=
TOKEN_HASH_SECRET=
SUPER_ADMIN_EMAIL=admin@gest.local
SUPER_ADMIN_PASSWORD=Odiljon(2008)
CENTRE_ADMIN_EMAIL=centre@gest.local
CENTRE_ADMIN_PASSWORD=
DEMO_CANDIDATE_EMAIL=demo@gest.local
DEMO_CANDIDATE_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GEST <no-reply@gest.local>"
CHROMIUM_PATH=
TRUST_PROXY=false

# Random 32-byte hex key (auto-generated by npm start). Keep with encrypted document backups.
IDENTITY_ENCRYPTION_KEY=

# Sandbox is disabled automatically when NODE_ENV=production
PAYMENT_MODE=sandbox
FEE_WAIVER_HMAC_SECRET=
