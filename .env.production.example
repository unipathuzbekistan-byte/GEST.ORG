# Copy to .env.production. NEVER add this file to Git or send it to anyone.
# Better: run `node scripts/create-production-env.js` to create fresh random keys and passwords.
GEST_DOMAIN=gest.example
NODE_ENV=production
PORT=3000
BASE_URL=https://gest.example
TRUST_PROXY=true
DATABASE_PATH=/app/storage/db/gest.sqlite
CHROMIUM_PATH=/usr/bin/chromium
GEST_PUBLIC_PILOT_MODE=false
SENSITIVE_UPLOADS_ENABLED=false
PAYMENT_MODE=manual
SESSION_SECRET=CHANGE_ME_64_HEX
VERIFICATION_HMAC_SECRET=CHANGE_ME_64_HEX
TOKEN_HASH_SECRET=CHANGE_ME_64_HEX
FEE_WAIVER_HMAC_SECRET=CHANGE_ME_64_HEX
IDENTITY_ENCRYPTION_KEY=CHANGE_ME_64_HEX
SUPER_ADMIN_EMAIL=admin@gest.example
SUPER_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARACTERS
CENTRE_ADMIN_EMAIL=centre@gest.example
CENTRE_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARACTERS
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=GEST <noreply@gest.example>
SEED_DEMO=false
