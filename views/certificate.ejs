<!doctype html><html lang="en"><head><meta charset="utf-8"><title><%= cert.form_number %> — GEST Test Report Form</title><style>
@page{size:A4 portrait;margin:0}*{box-sizing:border-box}html,body{margin:0;padding:0;color:#0d3158;font-family:Montserrat,Arial,Helvetica,sans-serif}body{-webkit-print-color-adjust:exact;print-color-adjust:exact}.sheet{width:210mm;height:297mm;position:relative;overflow:hidden;background-color:#fff;padding:16mm 13mm 12mm 17mm}.sheet:before{content:"GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST     GEST · GLOBAL ENGLISH SKILLS TEST";font-size:7px;letter-spacing:3px;line-height:23px;position:absolute;inset:26px 9px;color:rgba(13,49,88,.055);transform:rotate(-27deg) scale(1.55);width:880px;height:1200px;word-spacing:12px;overflow:hidden;z-index:0;pointer-events:none}.sheet:after{content:"";position:absolute;width:440px;height:440px;border:1px solid rgba(201,162,75,.13);border-radius:48% 52% 45% 55%;top:300px;left:175px;background:repeating-radial-gradient(ellipse at center,transparent 0px,transparent 9px,rgba(201,162,75,.05) 10px,transparent 11px),repeating-conic-gradient(from 8deg,transparent 0deg,rgba(13,49,88,.024) 3deg,transparent 6deg);z-index:0;pointer-events:none}.sheet>*{position:relative;z-index:1}.top-line{position:absolute;top:0;left:0;width:100%;height:7px;background:linear-gradient(90deg,#c9a24b 0 24%,#0d3158 24% 88%,#c9a24b 88%)}.holo{position:absolute;right:0;top:10px;bottom:0;width:7mm;background:repeating-linear-gradient(150deg,#bea4eb,#c7f0e7 8px,#d4b074 13px,#97accf 19px,#f5e2b5 27px);opacity:.55;z-index:2}.vertical-form{position:absolute;left:3mm;top:107mm;writing-mode:vertical-rl;transform:rotate(180deg);font-size:8px;letter-spacing:3px;font-weight:bold;color:#718094}.header{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:94px;border-bottom:2px solid #c9a24b;padding-bottom:9px}.logo{width:250px;max-height:93px;object-fit:contain;object-position:left center;mix-blend-mode:normal;background:transparent}.logo-fallback{font-size:40px;font-weight:900;letter-spacing:-2px;color:#0d3158}.logo-fallback small{display:block;font-size:9px;letter-spacing:2px}.header-right{text-align:right;max-width:320px}.header-right h1{font-size:25px;letter-spacing:-.7px;margin:0 0 8px}.header-right p{font-size:8.4px;line-height:1.5;color:#5a6b80;margin:0}.microline{font-size:5px;white-space:nowrap;letter-spacing:.58px;margin:5px 0 10px;color:#718094}.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.greybox{background:#eaf0f3;border:1px solid #d7e0e6;padding:8px 9px;min-height:44px}.greybox small,.field small{display:block;font-size:8px;font-weight:700;color:#5a6b80;letter-spacing:.2px;margin-bottom:5px;text-transform:uppercase}.greybox strong,.field strong{font-size:12px;font-weight:700;overflow-wrap:anywhere}.section-title{background:#0d3158;color:#fff;text-transform:uppercase;letter-spacing:1.5px;font-size:10px;font-weight:700;padding:7px 10px;margin:14px 0 8px;border-left:5px solid #c9a24b}.candidate-layout{display:grid;grid-template-columns:1fr 117px;gap:11px}.candidate-fields{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.field{background:#eef2f4;min-height:39px;padding:7px 8px}.photo{height:164px;width:117px;object-fit:cover;border:3px solid #e5ebee}.photo-placeholder{height:164px;background:#e2e8ee;display:grid;place-items:center;color:#5a6b80;font-size:12px}.results{display:grid;grid-template-columns:165px 1fr;gap:8px}.overall{background:#0d3158;color:white;border-radius:4px;padding:15px 12px 11px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:space-around}.overall small{font-size:11px;text-transform:uppercase;letter-spacing:1px}.overall .score{font-size:57px;font-weight:800;line-height:1}.overall .out-of{font-size:11px;opacity:.75}.level{border-radius:40px;background:#c9a24b;color:#0d3158;font-size:10px;font-weight:800;display:inline-block;padding:4px 11px;min-width:38px;text-align:center}.skillgrid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.skill{background:#eff3f5;padding:10px 11px 7px;min-height:88px}.skill-head{display:flex;justify-content:space-between;align-items:center;font-size:10px;font-weight:700;gap:5px}.skill strong{display:block;font-size:29px;margin:2px 0 4px}.track{height:5px;border-radius:9px;background:#cdd8e0;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#0d3158,#c9a24b)}.scale{display:flex;gap:4px;margin-top:10px}.scale div{flex:1;border:1px solid #cfd8df;background:#eff2f4;color:#5a6b80;text-align:center;padding:5px 2px;font-size:9px;font-weight:700}.scale div.active{background:#c9a24b;border-color:#987125;color:#0d3158}.scale-label{font-size:8px;color:#5a6b80;letter-spacing:.5px;text-transform:uppercase;margin:7px 0 0}.comments{min-height:42px;background:#eff2f4;padding:8px 10px;overflow:hidden}.comments strong{display:block;font-size:9px;text-transform:uppercase;margin-bottom:4px}.comments p{font-size:9px;color:#334b60;line-height:1.35;margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.security-area{display:grid;grid-template-columns:1fr 1fr 122px;gap:10px;align-items:center;margin-top:11px}.stamps{display:flex;justify-content:space-around;align-items:center;gap:7px}.stamp{width:94px;height:94px}.sign{font-size:8px;text-align:center;color:#5a6b80}.sign .signature-img{height:40px;max-width:100%;object-fit:contain;object-position:center;margin:0 auto 2px;display:block}.sign .signatory-name{font-size:9px;color:#0d3158;font-weight:800;line-height:1.3}.sign .signatory-title{font-size:8px;line-height:1.3;color:#5a6b80}.sign .signature{font-family:Georgia,serif;font-size:15px;font-style:italic;color:#0d3158;border-bottom:1px solid #0d3158;padding-bottom:5px;word-break:break-word}.sign p{margin:4px 0}.qr{text-align:center}.qr img{width:87px;height:87px;display:block;margin:0 auto}.qr small{font-size:7px;color:#5a6b80}.security-foot{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:7px}.security-foot .greybox{min-height:40px;padding:5px 8px}.security-foot strong{letter-spacing:.7px}.mrz{font-family:'Courier New',monospace;font-size:11.2px;font-weight:bold;line-height:1.25;letter-spacing:.38px;text-align:center;margin-top:8px;background:rgba(235,240,242,.9);padding:5px 2px;white-space:pre}.footer{font-size:8px;color:#5a6b80;text-align:center;margin-top:9px;border-top:1px solid #c9a24b;padding-top:7px;font-weight:600}.label-bottom{font-size:7px;text-align:center;color:#617080;letter-spacing:1px;margin-top:3px}

/* GEST security microtext v2: a *vector* pattern across the entire A4 page.
   Low contrast by design; QR, candidate data and results must remain legible.
   This is decorative copy deterrence, not proof of authenticity. */
.sheet:before{content:none!important}
.sheet .gest-security-microtext{position:absolute;inset:0;width:210mm;height:297mm;z-index:0;pointer-events:none;overflow:hidden;opacity:.23}
.sheet .gest-security-microtext text{fill:#0d3158;font-family:Montserrat,Arial,sans-serif;font-weight:700;font-size:7px;letter-spacing:1px}
.sheet .top-line,.sheet .holo,.sheet .vertical-form{position:absolute}
/* Larger, legible centre-authorised signature without displacing the QR or stamps. */
.security-area{grid-template-columns:minmax(0,1fr) minmax(0,1.08fr) 112px;column-gap:7px;margin-top:7px}
.sign{min-width:0}
.sign .signature-img{width:100%;height:44px;max-height:44px;max-width:165px;object-fit:contain;object-position:center center;margin:0 auto 2px;display:block;mix-blend-mode:multiply}
.sign .signatory-name{font-size:10px;line-height:1.18}
.sign .signatory-title{font-size:7.6px;line-height:1.18}
.sign p{margin:2px 0;line-height:1.18}
.stamp{width:90px;height:90px}
.security-foot{margin-top:5px}
.mrz{margin-top:6px;padding:4px 2px}
.footer{margin-top:7px;padding-top:6px}

/* Institutional centre and report seals are print-friendly PNG assets, not proofs
   of independent accreditation; online verification remains authoritative. */
.security-area{align-items:center}
.stamps{display:flex;align-items:center;justify-content:space-around;gap:3px;min-width:0}
.seal-panel{width:112px;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px}
.seal-image{display:block;width:104px;height:104px;max-width:100%;object-fit:contain;mix-blend-mode:multiply}
.seal-centre-code{font-weight:800;font-size:8px;letter-spacing:.4px;color:#0d3158;line-height:1.1;text-align:center}
.seal-fallback{display:grid;place-content:center;text-align:center;font-weight:900;font-size:17px;width:88px;height:88px;border:3px double #0d3158;border-radius:50%;color:#0d3158}
.seal-fallback small{font-size:8px;color:#c9a24b}
</style></head><body><div class="sheet"><svg class="gest-security-microtext" viewBox="0 0 794 1123" preserveAspectRatio="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="gest-security-tile" width="70" height="25" patternUnits="userSpaceOnUse" patternTransform="rotate(-22)"><text x="0" y="9">GEST</text><text x="35" y="22">GEST</text></pattern></defs><rect x="0" y="0" width="794" height="1123" fill="url(#gest-security-tile)"/></svg><div class="top-line"></div><div class="holo"></div><div class="vertical-form"><%= cert.form_number %> · GEST ORIGINAL REPORT</div><div class="header"><div><% if(logoData){ %><img class="logo" src="<%= logoData %>" alt="GEST logo"><% }else{ %><div class="logo-fallback">GEST<small>GLOBAL ENGLISH SKILLS TEST</small></div><% } %></div><div class="header-right"><h1>Test Report Form</h1><p>NOTE: Receiving organisations should consider the overall score alongside the individual skill scores. The validity and authenticity of this report must be checked online.</p></div></div><div class="microline">GEST GLOBAL ENGLISH SKILLS TEST · ISSUED WITH DIGITAL SECURITY IDENTIFIER · AUTHENTICATE ALL REPORTED SCORES AT THE OFFICIAL VERIFICATION PORTAL · GEST GLOBAL ENGLISH SKILLS TEST</div><div class="row3"><div class="greybox"><small>Centre number</small><strong><%= info.centre_code %></strong></div><div class="greybox"><small>Test date</small><strong><%= info.test_date %></strong></div><div class="greybox"><small>Candidate number</small><strong><%= info.candidate_number %></strong></div></div><div class="section-title">Candidate details</div><div class="candidate-layout"><div class="candidate-fields"><div class="field"><small>Family name</small><strong><%= info.family_name %></strong></div><div class="field"><small>First name</small><strong><%= info.first_name %></strong></div><div class="field"><small>Candidate ID</small><strong><%= info.id_document %></strong></div><div class="field"><small>Date of birth</small><strong><%= info.dob %></strong></div><div class="field"><small>Sex</small><strong><%= info.sex %></strong></div><div class="field"><small>Scheme code</small><strong>GEST-GEN</strong></div><div class="field"><small>Country of origin</small><strong><%= info.country_origin %></strong></div><div class="field"><small>Nationality</small><strong><%= info.nationality %></strong></div><div class="field"><small>First language</small><strong><%= info.first_language %></strong></div></div><div><% if(photoData){ %><img class="photo" src="<%= photoData %>" alt="Candidate photograph"><% }else{ %><div class="photo-placeholder">Photo on file</div><% } %></div></div><div class="section-title">Test results</div><div class="results"><div class="overall"><small>Overall score</small><span class="score"><%= info.overall %></span><span class="out-of">OUT OF 100</span><span class="level"><%= info.cefr %></span></div><div class="skillgrid"><% scores.forEach(s=>{ %><div class="skill"><div class="skill-head"><span><%= s.label %></span><span class="level"><%= s.level %></span></div><strong><%= s.score %></strong><div class="track"><div class="fill" style="width:<%= s.score %>%"></div></div></div><% }) %></div></div><p class="scale-label">CEFR proficiency scale · candidate's overall level highlighted</p><div class="scale"><% cefrBands.forEach(b=>{ %><div class="<%= b.label===info.cefr?'active':'' %>"><%= b.label %></div><% }) %></div><div class="section-title">Administrator comments</div><div class="comments"><p><%= info.comments||'No additional administrator comments.' %></p></div><div class="security-area"><div class="stamps"><div class="seal-panel"><% if(typeof centreSealData !== "undefined" && centreSealData){ %><img class="seal-image" src="<%= centreSealData %>" alt="GEST authorised test centre emblem"><% }else{ %><div class="seal-fallback">GEST<br><small>TEST CENTRE</small></div><% } %><span class="seal-centre-code"><%= info.centre_code %></span></div><div class="seal-panel"><% if(typeof verifiedSealData !== "undefined" && verifiedSealData){ %><img class="seal-image" src="<%= verifiedSealData %>" alt="GEST verified report emblem"><% }else{ %><div class="seal-fallback">GEST<br><small>VERIFIED</small></div><% } %><span class="seal-centre-code">GEST HQ</span></div></div><div class="sign"><% if(signatureData&&signatory){ %><img class="signature-img" src="<%= signatureData %>" alt="Authorised test centre signature"><div class="signatory-name"><%= signatory.signatory_name %></div><div class="signatory-title"><%= signatory.signatory_title %> · <%= info.centre_code %></div><% }else{ %><div class="signature">Signature not available</div><% } %><p>Authorised test centre representative</p><p>Issue date: <strong><%= cert.issue_date %></strong></p><p>Valid until: <strong><%= cert.expiry_date %></strong></p></div><div class="qr"><img src="<%= qrData %>" alt="QR code linking to GEST verification"><small>SCAN TO VERIFY ONLINE</small></div></div><div class="security-foot"><div class="greybox"><small>Security code</small><strong><%= security %></strong></div><div class="greybox"><small>Form number</small><strong><%= cert.form_number %></strong></div></div><div class="mrz"><%= line1 %>
<%= line2 %></div><div class="footer">The validity of this GEST Test Report Form can be verified online by receiving organisations.</div><div class="label-bottom">GEST · ASSESS · ACHIEVE · CONNECT</div></div></body></html>
