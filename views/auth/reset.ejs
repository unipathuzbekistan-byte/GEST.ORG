<section class="container content-narrow page-space"><div class="panel auth-panel"><h1>Choose a new password</h1><form class="form-stack" action="/reset-password/<%= token %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="password">New password (12 characters minimum)</label><input type="password" id="password" name="password" autocomplete="new-password" minlength="12" maxlength="128" required></div><button class="btn btn-primary">Reset password</button></form></div></section>
