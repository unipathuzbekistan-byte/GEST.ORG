<section class="auth-section"><div class="container auth-grid"><div class="auth-intro"><div class="eyebrow"><%= t('register.eyebrow') %></div><h1><%= t('register.title') %></h1><p class="lead"><%= t('register.intro') %></p><ul class="check-list"><li><%= t('register.benefit1') %></li><li><%= t('register.benefit2') %></li><li><%= t('register.benefit3') %></li></ul></div><div class="panel auth-panel"><h2><%= t('register.formTitle') %></h2><form class="form-stack" action="/register" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="email"><%= t('register.email') %></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"></div><div class="field"><label for="password"><%= t('register.password') %></label><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><small><%= t('register.passwordHint') %></small></div><label class="checkbox-row"><input required type="checkbox" name="consent"><span><%= t('register.consent') %> <a href="/privacy" target="_blank" rel="noopener"><%= t('register.privacy') %></a>.</span></label><button class="btn btn-primary btn-block" type="submit"><%= t('register.button') %></button></form><p class="small-center"><%= t('register.existing') %> <a href="/login"><%= t('register.login') %></a></p></div></div></section>
