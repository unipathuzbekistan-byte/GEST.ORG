<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="GEST — Global English Skills Test. Assess · Achieve · Connect. Book international English proficiency tests and verify results securely."><meta name="theme-color" content="#0d3158"><title><%= title %> | GEST</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/site.css" defer><script src="/js/site.js" defer></script></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="container header-row"><a href="/" class="brand" aria-label="GEST home"><% if(hasLogo){ %><img class="brand-logo" src="/img/logo.png" alt="GEST — Global English Skills Test"><% } else { %><span class="brand-mark">GEST</span><span class="brand-sub">Global English Skills Test</span><% } %></a><button type="button" class="nav-toggle" aria-controls="nav" aria-expanded="false">☰ <span class="sr-only">Toggle navigation</span></button><nav class="navigation" id="nav" aria-label="Main navigation"><a href="/"><%= t('nav.home') %></a><a href="/about"><%= t('nav.about') %></a><a href="/format"><%= t('nav.format') %></a><a href="/scoring"><%= t('nav.scoring') %></a><a href="/centres"><%= t('nav.centres') %></a><a href="/verify"><%= t('nav.verify') %></a><a href="/contact"><%= t('nav.contact') %></a><% if(user&&!user.disabled){ %><a class="nav-account" href="<%= user.role==='candidate'?'/candidate':user.role==='centre_admin'?'/centre':'/admin' %>"><%= t('nav.dashboard') %></a><form class="inline" action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="nav-text" type="submit"><%= t('nav.logout') %></button></form><% } else { %><a class="nav-account" href="/login"><%= t('nav.login') %></a><% } %></nav></div></header>
<main id="main" tabindex="-1"><% if(flash){ %><div class="container"><div role="status" class="alert <%= flash.type==='success'?'alert-success':'alert-warning' %>"><%= flash.msg %></div></div><% } %><%- body %></main><footer class="footer"><div class="container footer-grid"><div><strong>GEST</strong><p>Global English Skills Test</p><p>Assess · Achieve · Connect</p></div><div><strong>Explore</strong><a href="/format">Test format</a><a href="/scoring">Scores and CEFR</a><a href="/sessions">Book a test</a><a href="/faq">FAQ</a></div><div><strong>Trust and support</strong><a href="/verify">Verify a result</a><a href="/contact">Contact</a><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a></div></div><div class="container footer-bottom">© <%= new Date().getFullYear() %> GEST – Global English Skills Test. Official test records are verified online.</div></footer></body></html>
