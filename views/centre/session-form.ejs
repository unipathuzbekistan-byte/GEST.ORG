<section class="page-hero compact"><div class="container"><h1><%= title %></h1><p>Manage the date, time, available seats and booking status.</p></div></section><section class="container section content-narrow"><div class="panel"><form method="post" action="<%= session?'/centre/sessions/'+session.id+'/edit':'/centre/sessions/new' %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><div class="field"><label for="test_date">Test date</label><input type="date" id="test_date" name="test_date" required value="<%= session?.test_date||'' %>"></div><div class="field"><label for="start_time">Start time (local centre time)</label><input type="time" id="start_time" name="start_time" required value="<%= session?.start_time||'09:00' %>"></div><div class="field"><label for="capacity">Total capacity</label><input type="number" id="capacity" name="capacity" min="1" max="10000" required value="<%= session?.capacity||25 %>"></div><div class="field"><label for="status">Booking status</label><select id="status" name="status"><option value="open" <%= session?.status!=='closed'?'selected':'' %>>Open</option><option value="closed" <%= session?.status==='closed'?'selected':'' %>>Closed</option></select></div></div><div class="field"><label for="notes">Session notes (internal)</label><textarea id="notes" name="notes" maxlength="2000" rows="4"><%= session?.notes||'' %></textarea></div><button class="btn btn-primary">Save session</button><a class="btn btn-secondary" href="/centre">Cancel</a></form></div></section>
