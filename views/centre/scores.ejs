<section class="page-hero compact"><div class="container"><a class="hero-back" href="/centre/sessions/<%= booking.session_id %>">← Back to registrants</a><h1>Candidate scores</h1><p><%= booking.first_name %> <%= booking.family_name %> · <%= booking.candidate_number %> · <%= booking.test_date %></p></div></section><section class="container section content-wide"><div class="panel"><% if(result&&result.status!=='draft'){ %><div class="alert alert-warning">Scores are locked (<%= result.status %>). Contact GEST headquarters to reopen this result.</div><div class="score-preview"><% ['listening','reading','writing','speaking'].forEach(k=>{ %><div><small><%= k %></small><strong><%= result[k] %></strong></div><% }) %></div><p>Overall: <strong><%= result.overall %> · <%= result.cefr %></strong></p><p>Comments: <%= result.comments||'—' %></p><% }else{ %><form action="/centre/booking/<%= booking.id %>/scores" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><% ['listening','reading','writing','speaking'].forEach(k=>{ %><div class="field"><label for="<%= k %>"><%= k[0].toUpperCase()+k.slice(1) %> (0–100)</label><input type="number" name="<%= k %>" id="<%= k %>" min="0" max="100" step="1" required value="<%= result?.[k]??'' %>"></div><% }) %></div><div class="field"><label for="comments">Administrator comments</label><textarea id="comments" name="comments" maxlength="2000" rows="5"><%= result?.comments||'' %></textarea></div><div class="quick-actions"><button class="btn btn-secondary" name="action" value="draft">Save draft</button><button class="btn btn-primary" name="action" value="submitted" data-submit-confirm="Submit scores to headquarters? They will be locked until headquarters reopens them.">Submit for approval</button></div></form><% } %></div></section>
