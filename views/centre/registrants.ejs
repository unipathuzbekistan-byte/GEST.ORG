<section class="page-hero compact"><div class="container"><a class="hero-back" href="/centre">← All sessions</a><h1>Session registrants</h1><p><%= session.test_date %> at <%= session.start_time %> · Capacity <%= session.capacity %></p></div></section><section class="container section"><div class="alert alert-warning">At check-in, compare the original passport/ID with the uploaded document and capture a new official photo using the centre camera. Scores may be entered only after check-in.</div><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>ID verification</th><th>Payment</th><th>Check-in</th><th>Scores</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.family_name %>, <%= b.first_name %></strong><small><%= b.candidate_number %> · <%= b.email %></small></td><td><div class="photo-cell"><% if(b.official_photo_path){ %><img src="/centre/photo/<%= b.id %>" alt="Photo for <%= b.first_name %>"><% } %><small>ID: <%= b.id_document %></small><small>Upload: <%= b.doc_status||"Missing" %></small></div></td><td><% if(b.sandbox_payment_status){ %><strong><%= b.payment_status %></strong><small>Sandbox: <%= b.sandbox_payment_status %></small><% }else{ %><form method="post" action="/centre/booking/<%= b.id %>/payment" class="stack-tight"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status" aria-label="Payment status for <%= b.first_name %>"><option value="pending" <%= b.payment_status==='pending'?'selected':'' %>>Pending</option><option value="paid" <%= b.payment_status==='paid'?'selected':'' %>>Paid</option></select><button class="btn btn-small btn-secondary">Update</button></form><% } %></td><td><% if(b.identity_verified_at){ %><span class="status-good">✓ Verified & checked in</span><% }else if(b.checked_in_at){ %><span class="pill">Legacy check-in</span><% }else{ %><a href="/centre/booking/<%= b.id %>/identity" class="btn btn-small btn-primary">ID check &amp; centre photo</a><% } %></td><td><a href="/centre/booking/<%= b.id %>/scores" class="btn btn-small btn-secondary"><%= b.result_status||'Enter scores' %></a><% if(b.result_status){ %><small>Overall <%= b.overall??'–' %></small><% } %></td></tr><% }) %><% if(!bookings.length){ %><tr><td colspan="5">No candidates have booked this session.</td></tr><% } %></tbody></table></div></section>
