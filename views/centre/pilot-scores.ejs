<section class="page-hero compact"><div class="container"><a href="<%= backUrl %>" class="hero-back">← Back</a><div class="eyebrow">PILOT SCORING — NOT FOR OFFICIAL USE</div><h1><%= state.booking.first_name %> <%= state.booking.family_name %></h1><p><%= state.booking.candidate_number %> · <%= state.booking.form_code %> · <%= state.booking.test_date %></p></div></section>
<section class="container section content-wide">
<div class="alert alert-warning"><strong>Unvalidated pilot score.</strong> The mathematical 0–100 conversion and CEFR classification are provisional. Do not issue an official GEST Test Report Form for this assessment. Never share answer keys with markers or candidates.</div>
<% if(!state.booking.checked_in_at){ %><div class="alert alert-warning">Check in the candidate with original ID before entering any scores.</div><% } %>
<% const locked = !!(state.result&&state.result.status!=='draft') || !!state.assessment?.submitted_at; %>
<% if(locked){ %><div class="panel"><h2>Submitted pilot result</h2><p>Status: <strong><%= state.result?.status||'submitted' %></strong></p><div class="score-preview"><% ['listening','reading','writing','speaking'].forEach(k=>{ %><div><small><%= k %></small><strong><%= state.result?.[k]??'–' %></strong></div><% }) %></div><p><strong>Overall: <%= state.result?.overall??'–' %>/100 · Provisional CEFR: <%= state.result?.cefr??'–' %></strong></p><p>Scores are locked. Headquarters can review or reopen them.</p></div><% } else { %>
<% if(state.assessment){ %><div class="panel"><h2>Saved objective &amp; Speaking marks</h2><div class="score-preview"><div><small>Reading</small><strong><%= state.assessment.reading_correct %>/40 → <%= state.assessment.reading_score %></strong></div><div><small>Listening</small><strong><%= state.assessment.listening_correct %>/35 → <%= state.assessment.listening_score %></strong></div><div><small>Speaking</small><strong><%= state.assessment.speaking_score %></strong></div></div></div><% } %>
<% if(isCentre){ %>
<div class="panel mt"><h2>1. Reading, Listening &amp; Speaking</h2><p>Enter exactly 40 Reading answers and 35 Listening answers, separated by commas or new lines. For an unanswered question, enter <code>-</code>. Original answers are scored on the server against the Headquarters answer key; answers are not exposed here.</p>
<form method="post" action="/centre/booking/<%= state.booking.id %>/pilot/raw" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="field"><label for="reading_answers">Reading — 40 answers</label><textarea name="reading_answers" id="reading_answers" rows="6" spellcheck="false" maxlength="2800" required placeholder="A, B, C, D, ..."><%= state.assessment?JSON.parse(state.assessment.reading_responses).map(x=>x||'-').join(', '):'' %></textarea></div>
<div class="field"><label for="listening_answers">Listening — 35 answers</label><textarea name="listening_answers" id="listening_answers" rows="6" spellcheck="false" maxlength="2450" required placeholder="A, B, C, D, ..."><%= state.assessment?JSON.parse(state.assessment.listening_responses).map(x=>x||'-').join(', '):'' %></textarea></div>
<h3>Speaking rubric · 0–10 per criterion</h3><div class="form-grid"><% const sp=state.assessment?JSON.parse(state.assessment.speaking_rubric):{}; ['fluency','vocabulary','grammar','pronunciation'].forEach(k=>{ %><div class="field"><label for="sp-<%= k %>"><%= k[0].toUpperCase()+k.slice(1) %></label><input id="sp-<%= k %>" type="number" name="speaking_<%= k %>" required min="0" max="10" step="1" value="<%= sp[k]??'' %>"></div><% }) %></div>
<button class="btn btn-primary">Save objective and Speaking marks</button></form></div><% } %>
<div class="panel mt"><h2>2. Independent Writing assessment</h2><p>Task 1 weight: <strong>40%</strong> · Task 2 weight: <strong>60%</strong>. Each task has four criteria (0–10). A separate login is required for each marker; submitted marks cannot be edited by their assessor. The first two marks are averaged. If they differ by more than 10 points, a third independent examiner is required and the median of three scores is used.</p>
<p><strong><%= state.marks.length %></strong> Writing assessor(s) have submitted. <% if(state.writing?.needsThird && !state.writing.ready){ %><strong>Third independent examiner required (gap: <%= state.writing.gap %>).</strong><% }else if(state.writing?.ready){ %><strong>Writing score is ready.</strong><% } %></p>
<% if(state.marks.some(m=>m.assessor_id===user.id)){ %><div class="alert alert-warning">You already submitted your independent Writing assessment. Another eligible administrator must provide the next mark.</div><% }else if(state.marks.length<2 || state.writing?.needsThird&&!state.writing?.ready){ %>
<form method="post" action="<%= markUrl %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% for(const task of ['task1','task2']){ %><h3><%= task==='task1'?'Task 1 — Functional email':'Task 2 — Opinion essay' %></h3><div class="form-grid"><% for(const k of ['task','coherence','vocabulary','grammar']){ %><div class="field"><label for="<%= task %>_<%= k %>"><%= k==='task'?'Task achievement/response':k[0].toUpperCase()+k.slice(1) %></label><input type="number" min="0" max="10" step="1" required name="<%= task %>_<%= k %>" id="<%= task %>_<%= k %>"></div><% } %></div><% } %>
<button class="btn btn-primary" data-submit-confirm="Submit independent Writing assessment? You cannot modify it afterward.">Submit independent Writing mark</button></form>
<% }else{ %><p>All required independent Writing marks have been collected.</p><% } %></div>
<% if(isCentre){ %><div class="panel mt"><h2>3. Submit pilot score for Headquarters review</h2><% if(state.assessment&&state.writing?.ready){ %><p>Reading <strong><%= state.assessment.reading_score %></strong>, Listening <strong><%= state.assessment.listening_score %></strong>, Writing <strong><%= state.writing.score %></strong>, Speaking <strong><%= state.assessment.speaking_score %></strong>.</p><form method="post" action="/centre/booking/<%= state.booking.id %>/pilot/submit" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="comments">Administrator comments</label><textarea id="comments" name="comments" maxlength="2000" rows="3"></textarea></div><button class="btn btn-primary" data-submit-confirm="Submit and lock pilot scores for Headquarters review? No official certificate will be issued.">Submit pilot scores</button></form><% }else{ %><p>Save the raw scores and collect the required independent Writing assessments to enable submission.</p><% } %></div><% } %>
<% } %>
</section>
