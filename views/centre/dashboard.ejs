<section class="page-hero compact"><div class="container"><div class="eyebrow">TEST CENTRE ADMINISTRATION · <%= centre.code %></div><h1><%= centre.name %></h1><p><%= centre.city %>, <%= centre.country %></p></div></section><section class="container section"><div class="portal-top"><div><h2>Test sessions</h2><p class="subdued">Create sessions and manage candidates, payments, attendance and results.</p></div><a class="btn btn-primary" href="/centre/sessions/new">+ Create session</a></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Time</th><th>Booked / Capacity</th><th>Status</th><th>Manage</th></tr></thead><tbody><% sessions.forEach(s=>{ %><tr><td><%= s.test_date %></td><td><%= s.start_time %></td><td><%= s.booked %> / <%= s.capacity %></td><td><span class="pill"><%= s.status %></span></td><td><a class="btn btn-small btn-primary" href="/centre/sessions/<%= s.id %>">Registrants</a> <a class="btn btn-small btn-secondary" href="/centre/sessions/<%= s.id %>/edit">Edit</a></td></tr><% }) %><% if(!sessions.length){ %><tr><td colspan="5">No sessions yet. Create one to begin accepting bookings.</td></tr><% } %></tbody></table></div></section>
