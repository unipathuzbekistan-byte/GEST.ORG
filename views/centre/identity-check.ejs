<section class="page-hero compact"><div class="container"><a class="hero-back" href="/centre/sessions/<%= booking.session_id %>">← Session registrants</a><h1>On-site candidate ID check</h1><p>Authorised centre staff only · Candidate <%= booking.candidate_number||'pending number' %></p></div></section>
<section class="container section content-wide"><div class="panel" data-identity-capture>
<h2><%= booking.family_name %>, <%= booking.first_name %></h2><p><strong>Registered ID number:</strong> <%= booking.id_document %><br><strong>Exam date:</strong> <%= booking.test_date %></p>
<% if(check){ %><div class="alert alert-success">Identity verified on <%= check.verified_at %>. The official photograph is locked and will appear on this booking's certificate.</div><img src="/centre/photo/<%= booking.id %>" width="140" alt="Official centre photo"><% }else{ %>
<% if(!document){ %><div class="alert alert-warning">No passport or ID scan has been uploaded. Ask the candidate to upload it in their private account before check-in.</div><% }else{ %><p><strong>Uploaded evidence:</strong> <%= document.document_type==='passport'?'Passport':'National ID card' %> · <%= document.mime_type==='application/pdf'?'PDF document':'Image' %> · Status: <%= document.status %></p><p><a class="btn btn-secondary" href="/centre/booking/<%= booking.id %>/identity/document">Download ID securely for staff review</a></p><p class="subdued">Download-only; do not share the file. Compare the photo, document number and name with the physical original, and check authenticity yourself. The website does not automatically establish document authenticity.</p><% } %>
<h3>Take the official photograph at the centre</h3><p>Ask the candidate to stand in front of a plain background. Their full face must be clearly visible; no filters or retouching. The browser camera requires localhost or HTTPS.</p>
<div class="camera-box"><video id="identity-live-video" autoplay playsinline muted aria-label="Live camera preview" hidden></video><canvas id="identity-camera-frame" width="480" height="600" hidden></canvas><img id="identity-photo-preview" alt="Official photograph preview" hidden><p id="identity-camera-status" role="status">Camera not started.</p></div>
<div class="quick-actions"><button class="btn btn-secondary" type="button" id="identity-start-camera">Start camera</button><button class="btn btn-secondary" type="button" id="identity-take-photo" disabled>Capture photo</button><button class="btn btn-quiet" type="button" id="identity-retake-photo" disabled>Retake</button></div>
<form id="identity-verify-form" action="/centre/booking/<%= booking.id %>/identity/verify" method="post" enctype="multipart/form-data" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="field"><label for="identity-photo-file">Alternative: take a photo with the device camera *</label><input id="identity-photo-file" type="file" name="official_photo" accept="image/png,image/jpeg" capture="user" required><small>Only staff at this test centre may capture this photo; do not use a candidate-supplied portrait.</small></div>
<label class="checkbox-row"><input type="checkbox" name="candidate_present" required><span>I confirm this candidate is physically present at our test centre.</span></label>
<label class="checkbox-row"><input type="checkbox" name="id_confirmed" required><span>I personally checked the original ID/passport and confirmed the identity details match the applicant.</span></label>
<button class="btn btn-primary" type="submit" <%= !document||document.status==='rejected'?'disabled':'' %>>Verify identity and check in</button>
</form>
<% } %>
</div></section>
<script src="/js/identity-camera.js" defer></script>
