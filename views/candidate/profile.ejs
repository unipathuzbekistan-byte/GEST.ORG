<section class="page-hero compact"><div class="container"><div class="eyebrow">CANDIDATE PORTAL</div><h1>Identity registration</h1><p>Your official certificate photo is taken by an authorised administrator at your test centre.</p></div></section>
<section class="container section content-wide">
<div class="alert alert-warning">Identity documents contain sensitive information. Upload only your own document. Do not submit a document by email. The original must be presented to staff at check-in.</div>
<div class="panel">
<h2>Step 1 · Personal details</h2>
<% if(identityLocked){ %><p class="alert alert-success">Your identity details are locked after check-in. Contact GEST headquarters if a correction is required.</p><% } %>
<form action="/candidate/profile" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><fieldset <%= identityLocked?'disabled':'' %>><legend class="sr-only">Your official identity information</legend><div class="form-grid">
<div class="field"><label for="family_name">Family name *</label><input id="family_name" name="family_name" required maxlength="100" autocomplete="family-name" value="<%= candidate.family_name||'' %>"></div>
<div class="field"><label for="first_name">First name *</label><input id="first_name" name="first_name" required maxlength="100" autocomplete="given-name" value="<%= candidate.first_name||'' %>"></div>
<div class="field"><label for="dob">Date of birth *</label><input id="dob" type="date" name="dob" required value="<%= candidate.dob||'' %>"></div>
<div class="field"><label for="sex">Sex *</label><select id="sex" name="sex" required><option value="">Select</option><% ['Female','Male','Other','Prefer not to say'].forEach(v=>{ %><option value="<%= v %>" <%= candidate.sex===v?'selected':'' %>><%= v %></option><% }) %></select></div>
<div class="field"><label for="country_origin">Country of origin *</label><input id="country_origin" name="country_origin" required maxlength="100" value="<%= candidate.country_origin||'' %>"></div>
<div class="field"><label for="nationality">Nationality *</label><input id="nationality" name="nationality" required maxlength="100" value="<%= candidate.nationality||'' %>"></div>
<div class="field"><label for="first_language">First language *</label><input id="first_language" name="first_language" required maxlength="100" value="<%= candidate.first_language||'' %>"></div>
<div class="field"><label for="id_document">ID document number *</label><input id="id_document" name="id_document" required maxlength="80" autocomplete="off" value="<%= candidate.id_document||'' %>"></div>
<div class="field"><label for="phone">Phone number *</label><input id="phone" type="tel" name="phone" required maxlength="32" autocomplete="tel" value="<%= candidate.phone||'' %>"></div></div>
<label class="checkbox-row"><input type="checkbox" name="consent" required><span>I consent to the processing of my personal information and identity evidence under the <a href="/privacy">GEST Privacy policy</a>. *</span></label>
<button class="btn btn-primary">Save personal details</button></fieldset></form></div>
<div class="panel mt"><h2>Step 2 · Upload your identity document</h2><p>Choose your own passport or national ID card. Accepted: PDF, JPEG or PNG; maximum 5 MB. Scans must be clear and complete. Never upload a document belonging to another person.</p>
<% if(identityDocument){ %><p class="alert <%= identityDocument.status==='rejected'?'alert-warning':'alert-success' %>">Document received: <strong><%= identityDocument.document_type==='passport'?'Passport':'National ID card' %></strong> · Status: <strong><%= identityDocument.status %></strong> · <%= identityDocument.uploaded_at %>. <a href="/candidate/identity-document/download">Download my submitted copy</a></p><% }else{ %><p class="alert alert-warning">No identity document has been uploaded.</p><% } %>
<% if(!identityLocked){ %><form method="post" action="/candidate/identity-document" enctype="multipart/form-data" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><div class="field"><label for="document_type">Document type *</label><select name="document_type" id="document_type" required><option value="passport">Passport</option><option value="national_id">National ID card</option></select></div><div class="field"><label for="document">Document file *</label><input type="file" name="document" id="document" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required><small>The file is validated and stored encrypted; it is not publicly accessible.</small></div></div><button class="btn btn-primary">Upload ID securely</button></form><% } %>
<p class="subdued">Official candidate photo: <strong>Captured in person at the test centre</strong>. The candidate cannot replace this photo. The document is checked against the original during test-day check-in.</p>
<a class="btn btn-secondary" href="/candidate">Back to dashboard</a></div>
</section>
