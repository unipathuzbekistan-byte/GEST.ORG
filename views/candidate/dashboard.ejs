<section class="page-hero compact"><div class="container"><div class="eyebrow">CANDIDATE PORTAL</div><h1>Welcome<%= candidate.first_name?', '+candidate.first_name:'' %></h1><p>Manage your GEST registration, test bookings and reports.</p></div></section><section class="container section"><div class="portal-top"><div><h2>Your candidate profile</h2><p class="subdued">Candidate number: <strong><%= candidate.candidate_number||'Assigned on first booking' %></strong></p></div><a class="btn btn-secondary" href="/candidate/profile">Edit profile</a></div><% if(!complete){ %><div class="alert alert-warning">Your profile is incomplete. Add your identity details and upload a passport or national ID before booking a test. <a href="/candidate/profile">Complete your profile →</a></div><% } %><p class="subdued">ID document: <strong><%= identityDocument?identityDocument.status:"not uploaded" %></strong>. Official photo is taken at your centre on the test day.</p><% if(bookings.some(b=>b.checked_in_at)){ %><div class="profile-photo"><img src="/candidate/photo" alt="Official photograph captured by centre staff"></div><% } %><div class="quick-actions"><a class="btn btn-primary" href="/sessions">Browse available sessions</a><a class="btn btn-secondary" href="/candidate/data-export">Export my personal data (JSON)</a></div><h2 class="mt">My test bookings</h2><div class="table-wrap"><table><thead><tr><th>Test session</th><th>Booking</th><th>Payment / check-in</th><th>Results</th><th>Actions</th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><strong><%= b.centre_name %></strong><small><%= b.test_date %> · <%= b.start_time %></small></td><td><span class="pill"><%= b.status %></span></td><td><span><%= b.payment_status %></span><small><%= b.checked_in_at?'Checked in':'Not checked in' %></small></td><td><% if(b.result_status==='approved'){ %><strong><%= b.overall %> / 100 · <%= b.cefr %><%= b.is_pilot?' (PROVISIONAL PILOT — NOT AN OFFICIAL CERTIFICATE)':'' %></strong><small>L <%= b.listening %> · R <%= b.reading %> · W <%= b.writing %> · S <%= b.speaking %></small><% }else{ %><%= b.result_status==='submitted'?'Awaiting approval':b.result_status==='rejected'?'Under review':b.result_status==='draft'?'Processing':'Not available' %><% } %></td><td><% if(typeof canSandbox!=='undefined'&&canSandbox&&b.status==='booked'&&b.payment_status!=='paid'){ %><a class="btn btn-small btn-primary" href="/candidate/payment/<%= b.id %>">Pay in sandbox</a><% } %><% if(b.is_pilot&&b.result_status==='approved'){ %><a href="/candidate/pilot-report/<%= b.result_id %>" class="btn btn-small btn-secondary">Download Pilot Result PDF</a><% } %><% if(b.certificate_id){ %><a href="/candidate/certificate/<%= b.certificate_id %>" class="btn btn-small btn-primary">Download PDF</a><% } %><% if(b.status==='booked'&&!b.checked_in_at&&!b.result_id){ %><form class="inline" method="post" action="/candidate/cancel/<%= b.id %>" data-confirm="Cancel this booking? Cancellation is subject to the published deadline."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small btn-quiet">Cancel</button></form><% } %></td></tr><% }) %><% if(!bookings.length){ %><tr><td colspan="5">You have no bookings yet. <a href="/sessions">Choose a test date.</a></td></tr><% } %></tbody></table></div><div class="panel mt"><h3>Privacy and data rights</h3><p>You can export the personal data stored in your candidate account. You may also request account deletion, subject to legal record-retention obligations.</p><% if(candidate.deletion_requested_at){ %><p class="status-good">Deletion request received on <%= candidate.deletion_requested_at.slice(0,10) %>.</p><% }else{ %><form method="post" action="/candidate/deletion-request" data-confirm="Submit a formal deletion request to GEST headquarters?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-secondary">Request account deletion</button></form><% } %></div></section>
