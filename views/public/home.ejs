<section class="hero"><div class="container hero-grid"><div><div class="eyebrow"><%= t('home.eyebrow') %></div><h1><%= t('home.title') %></h1><p class="lead"><%= t('home.subtitle') %></p><div class="hero-actions"><a class="btn btn-gold" href="/sessions"><%= t('home.book') %> <span aria-hidden="true">→</span></a><a class="btn btn-light" href="/verify"><%= t('home.verify') %></a></div><p class="hero-caption"><%= t('home.tagline') %></p></div><div class="hero-visual" aria-hidden="true"><div class="hero-orbit"></div><div class="hero-disc">GEST<span>GLOBAL ENGLISH<br>SKILLS TEST</span></div><div class="hero-feature">4 SKILLS <span>·</span> 1 CERTIFICATE</div></div></div></section>
<section class="container section"><div class="section-head"><div><div class="eyebrow">THE GEST ADVANTAGE</div><h2><%= t('home.whyTitle') %></h2></div><p class="section-intro"><%= t('home.whyText') %></p></div><div class="card-grid three"><article class="feature-card"><div class="feature-icon">01</div><h3><%= t('home.card1Title') %></h3><p><%= t('home.card1Text') %></p></article><article class="feature-card"><div class="feature-icon">02</div><h3><%= t('home.card2Title') %></h3><p><%= t('home.card2Text') %></p></article><article class="feature-card"><div class="feature-icon">03</div><h3><%= t('home.card3Title') %></h3><p><%= t('home.card3Text') %></p></article></div></section>
<section class="section soft-bg"><div class="container"><div class="section-head"><div><div class="eyebrow">YOUR ASSESSMENT</div><h2><%= t('home.skillsTitle') %></h2></div><a href="/format" class="text-link">Full test format →</a></div><div class="card-grid four"><div class="skill-item"><span class="skill-number">01</span><h3>Reading</h3><strong>45 min</strong><p>40 questions</p></div><div class="skill-item"><span class="skill-number">02</span><h3>Listening</h3><strong>35 min</strong><p>35 questions</p></div><div class="skill-item"><span class="skill-number">03</span><h3>Writing</h3><strong>50 min</strong><p>2 tasks</p></div><div class="skill-item"><span class="skill-number">04</span><h3>Speaking</h3><strong>≈ 14 min</strong><p>3 parts</p></div></div></div></section>
<section class="section container"><div class="section-head"><div><div class="eyebrow">PLAN YOUR TEST</div><h2><%= t('home.upcomingTitle') %></h2></div><a class="text-link" href="/sessions"><%= t('home.allSessions') %> →</a></div><div class="card-grid two"><% if(sessions.length){sessions.forEach(s=>{ %><article class="session-card"><span class="date-chip"><%= s.test_date %></span><h3><%= s.centre_name %></h3><p><%= s.city %> · <%= s.code %> · <%= s.start_time %></p><div class="session-bottom"><span><%= s.remaining %> seats available</span><a class="btn btn-small btn-primary" href="/sessions"><%= t('home.book') %></a></div></article><% });}else{ %><div class="panel"><p>No upcoming sessions are currently listed. Check again soon or contact your preferred centre.</p><a href="/centres" class="text-link">Explore centres →</a></div><% } %></div></section>
<section class="cta-band"><div class="container cta-row"><div><h2><%= t('home.ctaTitle') %></h2><p><%= t('home.ctaText') %></p></div><a class="btn btn-gold" href="/register"><%= t('home.ctaButton') %></a></div></section>
