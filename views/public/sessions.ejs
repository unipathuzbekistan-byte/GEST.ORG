<section class="page-hero"><div class="container"><div class="eyebrow">BOOK YOUR ASSESSMENT</div><h1><%= t('booking.title') %></h1><p><%= t('booking.intro') %></p></div></section><section class="container section"><form method="get" action="/sessions" class="filter-row"><label for="centre"><%= t('booking.filter') %></label><select name="centre" id="centre"><option value="0"><%= t('booking.all') %></option><% centres.forEach(c=>{ %><option value="<%= c.id %>" <%= selected===c.id?'selected':'' %>><%= c.code %> — <%= c.name %></option><% }) %></select><button class="btn btn-secondary" type="submit"><%= t('booking.apply') %></button></form><div class="table-wrap"><table><thead><tr><th><%= t('booking.centre') %></th><th><%= t('booking.date') %></th><th><%= t('booking.time') %></th><th><%= t('booking.seats') %></th><th><%= t('booking.action') %></th></tr></thead><tbody><% sessions.forEach(s=>{ %><tr><td><strong><%= s.centre_name %></strong><small><%= s.code %> · <%= s.city %></small></td><td><%= s.test_date %></td><td><%= s.start_time %></td><td><span class="<%= s.remaining>0?'status-good':'status-bad' %>"><%= s.remaining %></span></td><td><% if(s.remaining>0){ %><% if(user?.role==='candidate'){ %><form method="post" action="/candidate/book/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small btn-primary"><%= t('booking.book') %></button></form><% }else{ %><a class="btn btn-small btn-primary" href="/register"><%= t('booking.register') %></a><% } %><% }else{ %><span class="subdued"><%= t('booking.full') %></span><% } %></td></tr><% }) %><% if(!sessions.length){ %><tr><td colspan="5">No upcoming sessions are currently available.</td></tr><% } %></tbody></table></div><p class="subdued"><%= t('booking.note') %></p></section>
