<section class="page-hero"><div class="container"><div class="eyebrow"><%= t('verify.eyebrow') %></div><h1><%= t('verify.title') %></h1><p><%= t('verify.intro') %></p></div></section><section class="container section verify-grid"><div class="panel"><h2><%= t('verify.formTitle') %></h2><form action="/verify" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="form_number"><%= t('verify.formNumber') %></label><input required id="form_number" name="form_number" maxlength="15" pattern="GEST-[0-9]{4}-[0-9]{5}" placeholder="GEST-2610-00001" autocomplete="off"></div><div class="field"><label for="security_code"><%= t('verify.code') %></label><input required id="security_code" name="security_code" maxlength="14" pattern="[A-Za-z2-9]{4}-[A-Za-z2-9]{4}-[A-Za-z2-9]{4}" placeholder="XXXX-XXXX-XXXX" autocomplete="off"></div><button class="btn btn-primary" type="submit"><%= t('verify.button') %></button></form><p class="help"><%= t('verify.help') %></p></div><div><% if(verification){ %><div class="panel result-box"><% if(verification.outcome==='valid'){const r=verification.record; %><div class="verified-status">✓ <%= t('verify.valid') %></div><div class="verify-person"><% if(r.photoData){ %><img src="<%= r.photoData %>" alt="Candidate passport photo"><% } %><div><h2><%= r.first_name %> <%= r.family_name %></h2><p><%= r.form_number %></p></div></div><dl class="details-grid"><div><dt>Test centre</dt><dd><%= r.centre_name %> (<%= r.centre_code %>)</dd></div><div><dt>Test date</dt><dd><%= r.test_date %></dd></div><div><dt>Overall score</dt><dd><strong><%= r.overall %> / 100</strong> <span class="level-pill"><%= r.cefr %></span></dd></div><div><dt>Expiry date</dt><dd><%= r.expiry_date %></dd></div><% ['listening','reading','writing','speaking'].forEach(k=>{ %><div><dt><%= k[0].toUpperCase()+k.slice(1) %></dt><dd><strong><%= r[k] %> / 100</strong></dd></div><% }) %></dl><p class="help">This certificate was authenticated against the GEST issuing database.</p><% }else if(['revoked','reissued','expired'].includes(verification.outcome)){ %><div class="invalid-status"><%= verification.outcome==='expired'?t('verify.expired'):t('verify.revoked') %></div><p><%= verification.outcome==='expired'?'This certificate has passed its validity date.':'This certificate is no longer valid. Request a current report from the candidate.' %></p><% }else{ %><div class="invalid-status"><%= t('verify.invalid') %></div><p><%= t('verify.invalidText') %></p><% } %></div><% } else { %><div class="verify-help-card"><div class="verify-help-icon">✓</div><h2>Protecting certificate integrity</h2><p>Every issued GEST Test Report Form contains a unique form number, a secure verification code and a QR link.</p><p>Always confirm a result here before relying on a printed or shared copy.</p></div><% } %></div></section>
