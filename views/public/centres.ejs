<section class="page-hero"><div class="container"><div class="eyebrow">TAKE YOUR TEST</div><h1>Approved test centres</h1><p>Find a GEST testing location and choose an available test session.</p></div></section><section class="container section"><div class="card-grid two"><% centres.forEach(c=>{ %><article class="panel centre-card"><div class="between"><span class="pill"><%= c.code %></span><span class="subdued"><%= c.country %></span></div><h2><%= c.name %></h2><p><strong><%= c.city %></strong></p><p><%= c.address %></p><a class="text-link" href="/sessions?centre=<%= c.id %>">View test sessions →</a></article><% }) %></div></section>
