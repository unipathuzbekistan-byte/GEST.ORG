<section class="page-hero compact"><div class="container"><h1>Edit user account</h1><p>Update email, role, centre assignment and verification status.</p></div></section><section class="container section content-narrow"><%- include('partials-nav') %><div class="panel"><form action="/admin/users/<%= account.id %>/edit" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="email">Email address</label><input id="email" type="email" name="email" value="<%= account.email %>" required></div><div class="field"><label for="role">Role</label><select id="role" name="role"><% ['candidate','centre_admin','super_admin'].forEach(r=>{ %><option value="<%= r %>" <%= account.role===r?'selected':'' %>><%= r %></option><% }) %></select><small>Existing candidate accounts cannot be converted to administrator accounts.</small></div><div class="field"><label for="centre_id">Centre (required for centre admins)</label><select id="centre_id" name="centre_id"><option value="">No centre</option><% centres.forEach(c=>{ %><option value="<%= c.id %>" <%= account.centre_id===c.id?'selected':'' %>><%= c.code %> — <%= c.name %></option><% }) %></select></div><div class="field"><label for="verified">Email verification</label><select id="verified" name="verified"><option value="1" <%= account.verified?'selected':'' %>>Verified</option><option value="0" <%= !account.verified?'selected':'' %>>Not verified</option></select></div><button class="btn btn-primary">Save account</button><a href="/admin/users" class="btn btn-secondary">Cancel</a></form></div></section>
