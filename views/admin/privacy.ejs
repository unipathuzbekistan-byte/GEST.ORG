<section class="page-hero compact"><div class="container"><h1>Privacy and deletion requests</h1><p>Review candidate data requests according to applicable legal retention rules.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="alert alert-warning">Completing an erasure anonymises the candidate account, revokes certificates and removes stored ID document copies, centre photographs and certificate PDFs. Preserve records where required by law. Confirm the applicable retention obligations before using this irreversible action.</div><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Submitted</th><th>Status</th><th>Review decision</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><strong><%= r.first_name %> <%= r.family_name %></strong><small><%= r.email %> · <%= r.candidate_number||'—' %></small></td><td><%= r.requested_at %></td><td><span class="pill"><%= r.status %></span><% if(r.review_note){ %><small><%= r.review_note %></small><% } %></td><td><% if(['pending','in_review'].includes(r.status)){ %><form action="/admin/privacy-requests/<%= r.id %>" method="post" class="stack-tight" data-confirm="Submit this privacy review decision?"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr-only" for="status-<%= r.id %>">Review action for <%= r.email %></label><select id="status-<%= r.id %>" name="status" required><option value="in_review">Mark in review</option><option value="declined">Decline with explanation</option><option value="completed">Complete irreversible erasure</option></select><label class="sr-only" for="note-<%= r.id %>">Review note</label><textarea id="note-<%= r.id %>" name="note" rows="2" minlength="5" required placeholder="Decision and legal basis"></textarea><label class="checkbox-row"><input type="checkbox" name="legal_confirmed"><span>I confirm retention rules permit erasure (required only to complete erasure).</span></label><button class="btn btn-small btn-secondary">Save review</button></form><% }else{ %><span class="subdued">Reviewed <%= r.reviewed_at||'' %></span><% } %></td></tr><% }) %><% if(!requests.length){ %><tr><td colspan="4">No deletion requests received.</td></tr><% } %></tbody></table></div></section>
