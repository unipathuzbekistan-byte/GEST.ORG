<section class="page-hero compact"><div class="container"><h1><%= title %></h1><p>Manage centre identity and availability.</p></div></section><section class="container section content-wide"><%- include('partials-nav') %><div class="panel"><form class="form-stack" method="post" action="<%= centre?'/admin/centres/'+centre.id+'/edit':'/admin/centres/new' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><div class="field"><label for="code">Permanent centre code (ISO country + 3 digits)</label><input id="code" name="code" pattern="[A-Z]{2}[0-9]{3}" maxlength="5" placeholder="UZ002" value="<%= centre?.code||'' %>" required <%= centre?'readonly':'' %>></div><div class="field"><label for="name">Centre name</label><input id="name" name="name" required value="<%= centre?.name||'' %>"></div><div class="field"><label for="country">Country</label><input id="country" name="country" required value="<%= centre?.country||'' %>"></div><div class="field"><label for="city">City</label><input id="city" name="city" required value="<%= centre?.city||'' %>"></div><div class="field"><label for="address">Address</label><input id="address" name="address" required value="<%= centre?.address||'' %>"></div><div class="field"><label for="active">Status</label><select id="active" name="active"><option value="1" <%= centre?.active!==0?'selected':'' %>>Active</option><option value="0" <%= centre?.active===0?'selected':'' %>>Inactive</option></select></div></div><button class="btn btn-primary">Save centre</button><% if(centre){ %><a class="btn btn-secondary" href="/admin/centres/<%= centre.id %>/signature">Authorised signature</a><% } %><a href="/admin/centres" class="btn btn-secondary">Cancel</a></form></div></section>
