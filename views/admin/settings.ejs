<section class="page-hero compact"><div class="container"><h1>Settings and CEFR bands</h1><p>Policy settings and score classification. Changes are recorded in the audit log.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="card-grid two"><div class="panel"><h2>Operational settings</h2><form action="/admin/settings" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><% const map=Object.fromEntries(settings.map(x=>[x.key,x.value])); %><div class="field"><label for="cancel_days">Minimum days before session to cancel</label><input type="number" min="0" max="365" required id="cancel_days" name="cancel_days" value="<%= map.cancel_days %>"></div><div class="field"><label for="cert_valid_years">Certificate validity (years)</label><input type="number" min="1" max="10" required id="cert_valid_years" name="cert_valid_years" value="<%= map.cert_valid_years %>"></div><div class="field"><label for="data_retention_years">Data retention policy (years)</label><input type="number" min="1" max="25" required id="data_retention_years" name="data_retention_years" value="<%= map.data_retention_years %>"><small>Policy only; automatic deletion is deliberately disabled pending legal retention review.</small></div><div class="field"><label for="headquarters_email">Headquarters email</label><input type="email" required id="headquarters_email" name="headquarters_email" value="<%= map.headquarters_email %>"></div><div class="field"><label for="booking_information">Booking/payment information</label><textarea id="booking_information" name="booking_information" maxlength="500" rows="3"><%= map.booking_information %></textarea></div><button class="btn btn-primary">Save settings</button></form></div><div class="panel"><h2>CEFR score bands</h2><p class="help">Every score from 0 to 100 must belong to exactly one band, with no gaps or overlaps.</p><form method="post" action="/admin/bands" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="table-wrap"><table><thead><tr><th>Level</th><th>Minimum</th><th>Maximum</th></tr></thead><tbody><% bands.forEach((b,i)=>{ %><tr><td><strong><%= b.label %></strong></td><td><label class="sr-only" for="min-<%= i %>">Minimum for <%= b.label %></label><input class="short-input" id="min-<%= i %>" name="min_<%= i %>" type="number" min="0" max="100" required value="<%= b.min_score %>"></td><td><label class="sr-only" for="max-<%= i %>">Maximum for <%= b.label %></label><input class="short-input" id="max-<%= i %>" name="max_<%= i %>" type="number" min="0" max="100" required value="<%= b.max_score %>"></td></tr><% }) %></tbody></table></div><button class="btn btn-primary" data-submit-confirm="Update all CEFR bands? Newly approved reports will use these ranges.">Save CEFR bands</button></form></div></div></section>
