<section class="page-hero compact"><div class="container"><h1>Administrative audit log</h1><p>Recent traceable administrator and candidate actions.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="table-wrap"><table><thead><tr><th>Timestamp (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= l.created_at %></td><td><%= l.actor||'System' %></td><td><%= l.action %></td><td><%= l.entity %> #<%= l.entity_id %></td><td><code class="wrap-code"><%= l.details %></code></td></tr><% }) %></tbody></table></div></section>
