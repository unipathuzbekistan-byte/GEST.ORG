<section class="page-hero compact"><div class="container"><div class="eyebrow">GEST HEADQUARTERS</div><h1>Administration overview</h1><p>Manage secure results, centres, accounts and certificate issuance.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="stat-grid"><div class="stat"><strong><%= counts.centres %></strong><span>Test centres</span></div><div class="stat"><strong><%= counts.candidates %></strong><span>Candidates</span></div><div class="stat"><strong><%= counts.pending %></strong><span>Awaiting approval</span></div><div class="stat"><strong><%= counts.certificates %></strong><span>Active certificates</span></div></div><div class="portal-top mt"><h2>Results awaiting approval</h2><a class="btn btn-secondary" href="/admin/results">All results</a></div><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Centre</th><th>Overall</th><th>Submitted</th><th>Action</th></tr></thead><tbody><% recent.forEach(r=>{ %><tr><td><%= r.first_name %> <%= r.family_name %></td><td><%= r.centre_code %></td><td><strong><%= r.overall %></strong> · <%= r.cefr %></td><td><%= r.submitted_at?.slice(0,10)||'—' %></td><td><a class="btn btn-small btn-primary" href="/admin/results/<%= r.id %>">Review</a></td></tr><% }) %><% if(!recent.length){ %><tr><td colspan="5">No results currently await approval.</td></tr><% } %></tbody></table></div></section>
