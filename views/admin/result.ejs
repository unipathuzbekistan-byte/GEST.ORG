<section class="page-hero compact"><div class="container"><a class="hero-back" href="/admin/results">← All results</a><h1>Review candidate result</h1><p><%= result.first_name %> <%= result.family_name %> · Candidate <%= result.candidate_number %></p></div></section><section class="container section"><%- include('partials-nav') %><div class="card-grid two"><div class="panel"><h2>Candidate and session</h2><dl class="details-grid"><div><dt>Candidate</dt><dd><%= result.first_name %> <%= result.family_name %></dd></div><div><dt>Email</dt><dd><%= result.email %></dd></div><div><dt>Test centre</dt><dd><%= result.centre_name %> (<%= result.centre_code %>)</dd></div><div><dt>Test date</dt><dd><%= result.test_date %></dd></div><div><dt>Current status</dt><dd><span class="pill"><%= result.status %></span></dd></div></dl></div><div class="panel"><h2>Skill scores</h2><div class="score-preview"><% ['listening','reading','writing','speaking'].forEach(k=>{ %><div><small><%= k %></small><strong><%= result[k] %></strong></div><% }) %></div><div class="overall-row"><span>Overall score</span><strong><%= result.overall %> / 100</strong><span class="level-pill"><%= result.cefr %></span></div><h3>Administrator comments</h3><p class="multiline"><%= result.comments||'No comments provided.' %></p><% if(result.rejection_reason){ %><div class="alert alert-warning">Rejection reason: <%= result.rejection_reason %></div><% } %></div></div><div class="panel mt"><h2>Review actions</h2><% if(isPilot){ %><div class="alert alert-warning"><strong>PILOT DIAGNOSTIC — NOT FOR OFFICIAL USE.</strong> These CEFR bands are provisional. Approving will not issue an official Test Report Form. <% if(result.status==='approved'){ %><a href="/admin/pilot/results/<%= result.id %>">View printable diagnostic report</a>. <a class="btn btn-small btn-secondary" href="/admin/pilot/results/<%= result.id %>/pdf">Download Pilot Result PDF</a><% } %> <a href="/admin/pilot/booking/<%= result.booking_id %>">Independent Writing marking</a></div><% } %><% if(!signatoryReady&&!isPilot){ %><div class="alert alert-warning">This centre does not yet have an approved signature. New certificates cannot be issued. <a href="/admin/centres/<%= result.centre_id %>/signature">Approve a centre signature first</a>.</div><% } %><% if(result.status==='submitted'){ %><div class="quick-actions"><form method="post" action="/admin/results/<%= result.id %>/approve" data-confirm="Approve the four scores and issue a secure PDF Test Report Form?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary" <%= !isPilot&&!signatoryReady?'disabled':'' %>><%= isPilot?'Approve pilot diagnostic only':'Approve and issue certificate' %></button></form><form method="post" action="/admin/results/<%= result.id %>/reject" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="reason">Reason for rejection</label><textarea id="reason" name="reason" rows="2" minlength="3" maxlength="1000" required></textarea><button class="btn btn-secondary">Reject scores</button></form></div><% }else if(!isPilot&&result.status==='approved'&&!certificates.some(c=>c.status==='valid')){ %><form method="post" action="/admin/results/<%= result.id %>/reissue"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary" <%= !signatoryReady?'disabled':'' %>>Issue a new certificate</button></form><% }else{ %><p>Result status: <strong><%= result.status %></strong>.</p><% } %><% if(result.status!=='draft'){ %><form method="post" action="/admin/results/<%= result.id %>/reopen" data-confirm="Reopen the scores for centre editing? Active certificates must be revoked first."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-quiet">Reopen scores</button></form><% } %></div><div class="panel mt"><h2>Test Report Forms</h2><% if(!certificates.length){ %><p>No certificates have been issued.</p><% } %><% certificates.forEach(c=>{ %><div class="cert-history"><div><strong><%= c.form_number %></strong><p>Issued <%= c.issue_date %> · Expires <%= c.expiry_date %> · <span class="pill"><%= c.status %></span></p><p><small>Signature at issue: <%= c.signatory_name?c.signatory_name+' — '+c.signatory_title:'Legacy certificate (no versioned centre signature)' %></small></p><% if(c.revoked_reason){ %><small><%= c.revoked_reason %></small><% } %></div><div class="stack-tight"><a class="btn btn-small btn-secondary" href="/admin/certificates/<%= c.id %>/pdf">Download PDF</a><% if(c.status==='valid'){ %><form action="/admin/certificates/<%= c.id %>/revoke" method="post" class="stack-tight" data-confirm="Revoke this certificate? The public verification page will immediately mark it invalid."><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr-only" for="revoke-<%= c.id %>">Revocation reason</label><input id="revoke-<%= c.id %>" name="reason" minlength="3" required placeholder="Revocation reason"><button class="btn btn-small btn-danger">Revoke</button></form><form action="/admin/results/<%= result.id %>/reissue" method="post" data-confirm="Reissue with a new form number and verification code? The old certificate will be invalidated."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small btn-primary" <%= !signatoryReady?'disabled':'' %>>Reissue</button></form><% } %></div></div><% }) %></div></section>
