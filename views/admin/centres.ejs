<section class="page-hero compact"><div class="container"><h1>Manage test centres</h1><p>Centre codes are permanent identifiers and cannot be reused.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="portal-top"><h2>Centres</h2><a class="btn btn-primary" href="/admin/centres/new">+ Add centre</a></div><div class="table-wrap"><table><thead><tr><th>Code</th><th>Centre</th><th>Location</th><th>Status</th><th>Action</th></tr></thead><tbody><% centres.forEach(c=>{ %><tr><td><strong><%= c.code %></strong></td><td><%= c.name %></td><td><%= c.city %>, <%= c.country %><small><%= c.address %></small></td><td><span class="pill"><%= c.active?'Active':'Inactive' %></span></td><td><a href="/admin/centres/<%= c.id %>/edit" class="btn btn-small btn-secondary">Edit</a> <a href="/admin/centres/<%= c.id %>/signature" class="btn btn-small btn-secondary">Authorised signature</a></td></tr><% }) %></tbody></table></div></section>
