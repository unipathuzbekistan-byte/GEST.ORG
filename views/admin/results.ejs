<section class="page-hero compact"><div class="container"><h1>Candidate results</h1><p>Review submitted scores, search candidates and export results.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="portal-top"><h2>Results database</h2><a class="btn btn-secondary" href="/admin/export.csv">Export CSV</a></div><form class="filter-row" method="get" action="/admin/results"><div class="field"><label for="q">Search by email, candidate number or surname</label><input id="q" name="q" value="<%= q %>" placeholder="Search candidates"></div><div class="field"><label for="status">Review status</label><select id="status" name="status"><option value="">All statuses</option><% ['submitted','approved','rejected','draft'].forEach(x=>{ %><option value="<%= x %>" <%= status===x?'selected':'' %>><%= x %></option><% }) %></select></div><button class="btn btn-primary">Search</button></form><div class="table-wrap"><table><thead><tr><th>Candidate</th><th>Centre / date</th><th>Score</th><th>Status</th><th>Review</th></tr></thead><tbody><% results.forEach(r=>{ %><tr><td><strong><%= r.family_name %>, <%= r.first_name %></strong><small><%= r.candidate_number %> · <%= r.email %></small></td><td><%= r.centre_code %><small><%= r.test_date %></small></td><td><strong><%= r.overall %></strong> · <%= r.cefr %><% if(r.is_pilot){ %><small>PILOT — provisional only</small><% } %></td><td><span class="pill"><%= r.status %></span></td><td><a class="btn btn-small btn-secondary" href="/admin/results/<%= r.id %>">View</a></td></tr><% }) %><% if(!results.length){ %><tr><td colspan="5">No matching results.</td></tr><% } %></tbody></table></div></section>
