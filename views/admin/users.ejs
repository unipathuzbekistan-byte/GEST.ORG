<section class="page-hero compact"><div class="container"><h1>Manage users and administrators</h1><p>Create authorised centre and headquarters accounts, reset passwords and manage access.</p></div></section><section class="container section"><%- include('partials-nav') %><div class="panel"><h2>Create administrator account</h2><form method="post" action="/admin/users/new" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label for="email">Email</label><input type="email" id="email" name="email" required></div><div class="field"><label for="password">Initial password (12+ characters)</label><input type="password" id="password" name="password" minlength="12" required autocomplete="new-password"></div><div class="field"><label for="role">Role</label><select id="role" name="role"><option value="centre_admin">Centre administrator</option><option value="super_admin">GEST headquarters administrator</option></select></div><div class="field"><label for="centre_id">Assigned centre (for centre administrators)</label><select id="centre_id" name="centre_id"><option value="">Select centre</option><% centres.forEach(c=>{ %><option value="<%= c.id %>"><%= c.code %> · <%= c.name %></option><% }) %></select></div><button class="btn btn-primary">Create administrator</button></form></div><h2 class="mt">Existing users (latest 500)</h2><div class="table-wrap"><table><thead><tr><th>Email</th><th>Role / centre</th><th>Email verified</th><th>Account</th><th>Password reset</th><th>Edit</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.email %></td><td><%= u.role %><small><%= u.centre_code||'—' %></small></td><td><%= u.verified?'Yes':'No' %></td><td><form action="/admin/users/<%= u.id %>/disable" method="post" class="stack-tight"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="disabled" value="<%= u.disabled?'0':'1' %>"><button type="submit" class="btn btn-small btn-secondary" <%= u.id===user.id?'disabled':'' %>><%= u.disabled?'Enable':'Disable' %></button></form></td><td><form action="/admin/users/<%= u.id %>/password" method="post" class="stack-tight"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr-only" for="password-<%= u.id %>">New password for <%= u.email %></label><input id="password-<%= u.id %>" name="password" type="password" minlength="12" required placeholder="New password"><button class="btn btn-small btn-secondary">Reset</button></form></td><td><a class="btn btn-small btn-secondary" href="/admin/users/<%= u.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div></section>
